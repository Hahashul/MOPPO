generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum MovementType {
  PURCHASE_IN
  PRODUCTION_OUT
  PRODUCTION_IN
  SALE_OUT
  ADJUSTMENT
  TRANSFER
  RETURN_IN
  RETURN_OUT
}

enum CustomFieldEntity {
  CONTACT
  ITEM
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

model Company {
  id           String                  @id @default(cuid())
  name         String
  template     String                  @default("custom") // lights | grocery | medical | custom
  currency     String                  @default("INR")
  country      String                  @default("IN")
  taxId        String? // GSTIN etc.
  settings     Json                    @default("{}")
  createdAt    DateTime                @default(now())
  members      Membership[]
  contacts     Contact[]
  items        Item[]
  itemKinds    ItemKind[]
  units        Unit[]
  warehouses   Warehouse[]
  movements    StockMovement[]
  audits       AuditLog[]
  customFields CustomFieldDefinition[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  authVersion  Int          @default(0) // bump to force logout everywhere
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model Membership {
  id        String  @id @default(cuid())
  userId    String
  companyId String
  role      Role    @default(STAFF)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

// A field a business adds to its own Contacts or Items.
// Never deleted, only hidden (isActive = false), so old data is not lost.
// The values live in the customFields JSON column of each record, under `key`.
model CustomFieldDefinition {
  id         String            @id @default(cuid())
  companyId  String
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entity     CustomFieldEntity
  key        String // stable id used inside the JSON, e.g. "wattage" (never changes)
  label      String // what the user sees, e.g. "Wattage" (can be renamed)
  type       CustomFieldType
  options    Json? // for SELECT: ["Warm White","Cool White"]
  isRequired Boolean           @default(false)
  showInList Boolean           @default(false)
  sortOrder  Int               @default(0)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([companyId, entity, key])
  @@index([companyId, entity, isActive])
}

// Item type, editable by the business (Raw material, Finished light, ...).
// The four flags drive stock, purchase, sales and recipe logic.
// Hidden (isActive = false), never deleted.
model ItemKind {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  tracksStock Boolean  @default(true)
  canBuy      Boolean  @default(false)
  canSell     Boolean  @default(false)
  canBeInBom  Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

// Unit of measure, editable by the business (pcs, set, mtr, ...).
// Hidden, never deleted.
model Unit {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String // short name stored on items, e.g. "pcs"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model Contact {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type         ContactType
  name         String
  code         String?
  email        String?
  phone        String?
  taxId        String?
  segment      String? // e.g. dealer / retail / project (drives pricing)
  creditLimit  Decimal     @default(0) @db.Decimal(14, 2)
  address      Json?
  customFields Json        @default("{}")
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([companyId, code])
  @@index([companyId, type])
}

model Item {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kindId       String
  kind         ItemKind        @relation(fields: [kindId], references: [id], onDelete: Restrict)
  sku          String
  name         String
  unit         String          @default("pcs")
  category     String?
  hsn          String?
  taxRate      Decimal         @default(0) @db.Decimal(5, 2)
  salePrice    Decimal         @default(0) @db.Decimal(14, 2)
  costPrice    Decimal         @default(0) @db.Decimal(14, 4)
  reorderLevel Decimal         @default(0) @db.Decimal(14, 3)
  trackBatch   Boolean         @default(false)
  customFields Json            @default("{}") // template fields: wattage, cct, expiry...
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  movements    StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId, kindId])
}

model Warehouse {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean         @default(false)
  movements StockMovement[]

  @@unique([companyId, name])
}

// Append-only. Never update or delete rows; fix mistakes with a new ADJUSTMENT row.
// Stock on hand = SUM(quantity) per item + warehouse. Positive = in, negative = out.
model StockMovement {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  type           MovementType
  quantity       Decimal      @db.Decimal(14, 3)
  unitCost       Decimal?     @db.Decimal(14, 4)
  batchNo        String?
  refType        String? // purchase | production | sale ...
  refId          String?
  idempotencyKey String?
  note           String?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@unique([companyId, idempotencyKey])
  @@index([companyId, itemId, warehouseId])
  @@index([companyId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  entity    String
  entityId  String?
  action    String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}